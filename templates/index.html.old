<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Election Sentiment AI</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<div class="container">
    <header>
        <h1>🗳️ Election Sentiment & Probability AI</h1>
        <p>Real-time analysis of political discourse using NLP</p>
    </header>

    <section class="map-card">
        <h2>Nepal District Map</h2>
        <iframe src="{{ url_for('static', filename='nepal_map_default.html') }}" title="Nepal District Map" class="map-frame"></iframe>
    </section>

    <section class="controls">
        <div class="input-group">
            <label>Select Candidate</label>
            <select id="candidateName">
                <option value="Balen">Balen Shah (RSP Alliance)</option>
                <option value="KP Oli">KP Oli (CPN-UML)</option>
                <option value="Gagan Thapa">Gagan Thapa (NC)</option>
                <option value="Prachanda">Prachanda (Maoist)</option>
                <option value="Harka Sampang">Harka Sampang</option>
            </select>
        </div>

        <div class="input-group">
            <label>Data Source</label>
            <select id="dataSource">
                <option value="youtube">YouTube Comments</option>
            </select>
        </div>
        
        <button onclick="runAnalysis()" id="analyzeBtn">Run Analysis</button>
    </section>

    <div id="loading" class="hidden">Connecting to YouTube API and analyzing 1,000+ comments...</div>

    <main id="dashboard" class="hidden">
        
        <div class="win-meter-container">
            <h2>Estimated Win Probability</h2>
            <div class="meter-bg">
                <div id="meterFill" class="meter-fill">0%</div>
            </div>
            <p id="ciText" class="ci-text"></p>
        </div>

        <div class="charts-grid">
            <div class="chart-card">
                <h3>Sentiment Distribution</h3>
                <canvas id="pieChart"></canvas>
            </div>
            <div class="chart-card">
                <h3>Model Performance</h3>
                <div id="modelMetrics" class="stat-list"></div>
            </div>
            <div class="chart-card">
                <h3>Script Breakdown</h3>
                <table id="scriptTable" class="mini-table">
                    <thead>
                        <tr>
                            <th>Script</th>
                            <th>Count</th>
                            <th>Mean Score</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="data-preview">
            <h3>Recent Mention Analysis</h3>
            <table id="dataTable">
                <thead>
                    <tr>
                        <th>Text Snippet</th>
                        <th>Sentiment</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </main>

    <section class="party-card">
        <h2>Party-Level Sentiment</h2>
        <p class="party-note">Mean sentiment across all comments mentioning each party's symbols/terms or its registered candidates -- see validate_parties.py.</p>
        <table id="partyTable" class="mini-table">
            <thead>
                <tr>
                    <th>Party</th>
                    <th>Comments</th>
                    <th>Mean Sentiment</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </section>
</div>

<script src="{{ url_for('static', filename='js/script.js') }}"></script>
</body>
</html>